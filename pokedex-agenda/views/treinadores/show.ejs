<%- include('../partials/header', { titulo: titulo }) %>
<%- include('../partials/navbar', { page: 'treinadores' }) %>

<div class="container mt-4">
  <a href="/treinadores" class="btn btn-outline-danger btn-sm mb-3">← Voltar</a>

  <div class="row">
    <div class="col-md-4">
      <div class="card-perfil text-center">
        <img src="<%= treinador.imagem ? '/img/' + treinador.imagem : '/img/ash.png' %>" class="perfil-img" alt="<%= treinador.nome %>">
        <h4 class="mt-2"><%= treinador.nome %></h4>
        <span class="badge bg-danger">Treinador Pokémon</span>
        <div class="mt-3 d-flex gap-2 justify-content-center">
          <a href="/treinadores/edit/<%= treinador.id %>" class="btn btn-sm btn-outline-secondary">Editar</a>
          <a href="/treinadores/delete/<%= treinador.id %>" class="btn btn-sm btn-outline-dark" onclick="return confirm('Excluir?')">Excluir</a>
        </div>
      </div>
    </div>

    <div class="col-md-8">
      <div class="card mb-3">
        <div class="card-body">
          <h5 class="card-title">Informações</h5>
          <table class="table tabela-treinador">
            <tbody>
              <tr>
                <th>Nome</th>
                <td><%= treinador.nome %></td>
              </tr>
              <tr>
                <th>Idade</th>
                <td><%= treinador.idade %> anos</td>
              </tr>
              <tr>
                <th>Região</th>
                <td><%= treinador.regiao %></td>
              </tr>
              <tr>
                <th>Cidade</th>
                <td><%= treinador.cidade %></td>
              </tr>
              <tr>
                <th>Insígnias</th>
                <td><%= treinador.insignias %>/8</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <h5 class="mb-3">Pokémons deste Treinador</h5>
          <% if (!treinador.pokemons || treinador.pokemons.length === 0) { %>
          <p class="text-muted">Nenhum Pokémon cadastrado para este treinador.</p>
          <% } else { %>
          <div class="row g-2">
            <% treinador.pokemons.forEach(p => { %>
            <div class="col-6 col-md-4">
              <div class="card text-center p-2">
                <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/<%= p.numero %>.png" style="width:64px;margin:auto">
                <strong><%= p.nome %></strong>
                <small class="text-muted"><%= p.tipo1 %><%= p.tipo2 !== '-' ? ' / ' + p.tipo2 : '' %></small>
              </div>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>