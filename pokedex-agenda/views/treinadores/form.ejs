<%- include('../partials/header', { titulo: titulo }) %>
<%- include('../partials/navbar', { page: 'treinadores' }) %>

<div class="container mt-4" style="max-width:600px">
  <h2 class="titulo-pagina"><%= titulo %></h2>

  <form method="POST" action="<%= acao === 'criar' ? '/treinadores/new' : '/treinadores/update/' + treinador.id %>">
    
    <% if (acao === 'editar') { %>
      <input type="hidden" name="id" value="<%= treinador.id %>">
    <% } %>

    <div class="mb-3">
      <label class="form-label">Nome</label>
      <input type="text" name="nome" class="form-control" value="<%= treinador.nome || '' %>" required>
    </div>

    <div class="row">
      <div class="col mb-3">
        <label class="form-label">Idade</label>
        <input type="number" name="idade" class="form-control" value="<%= treinador.idade || '' %>" min="10" required>
      </div>

      <div class="col mb-3">
        <label class="form-label">Insígnias</label>
        <input type="number" name="insignias" class="form-control" value="<%= treinador.insignias || 0 %>" min="0" max="8">
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label">Cidade</label>
      <input type="text" name="cidade" class="form-control" value="<%= treinador.cidade || '' %>" required>
    </div>

    <div class="mb-3">
      <label class="form-label">Região</label>
      <select name="regiao" class="form-select">
        <% ['Kanto','Johto','Hoenn','Sinnoh','Unova','Kalos','Alola','Galar','Paldea'].forEach(r => { %>
          <option value="<%= r %>" <%= (treinador.regiao === r) ? 'selected' : '' %>>
            <%= r %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="mb-3">
      <label class="form-label">Imagem do Treinador</label>
      <select name="imagem" class="form-select">
        <option value="ash.png" <%= treinador.imagem === 'ash.png' ? 'selected' : '' %>>Ash</option>
        <option value="brock.png" <%= treinador.imagem === 'brock.png' ? 'selected' : '' %>>Brock</option>
        <option value="misty.png" <%= treinador.imagem === 'misty.png' ? 'selected' : '' %>>Misty</option>
      </select>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-danger">
        <%= acao === 'criar' ? 'Cadastrar' : 'Salvar' %>
      </button>

      <a href="/treinadores" class="btn btn-outline-secondary">Cancelar</a>
    </div>

  </form>
</div>

<%- include('../partials/footer') %>