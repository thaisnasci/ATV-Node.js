  <%- include('partials/header', { titulo: titulo }) %>
  <%- include('partials/navbar', { page: 'treinador' }) %>

  <div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="titulo-pagina mb-0">Treinador Pokémon</h2>
      <a href="/treinadores" class="btn btn-danger">Gerenciar treinadores</a>
    </div>

    <% if (!treinador) { %>
    <div class="alert alert-warning">Nenhum treinador cadastrado ainda.</div>
    <% } else { %>
    <div class="row">

      <div class="col-md-4">
        <div class="card-perfil text-center">
          <img src="<%= treinador.imagem ? '/img/' + treinador.imagem : '/img/ash.png' %>" class="perfil-img" alt="<%= treinador.nome %>">

          <h4 class="mt-2"><%= treinador.nome %></h4>
          <span class="badge bg-danger">Mestre Pokémon</span>
        </div>
      </div>

      <div class="col-md-8">
        <div class="card">
          <div class="card-body">

            <h5 class="card-title">Informações do Treinador</h5>

            <table class="table tabela-treinador">
              <tbody>
                <tr>
                  <th>Nome</th>
                  <td><%= treinador.nome %></td>
                </tr>
                <tr>
                  <th>Idade</th>
                  <td><%= treinador.idade %> anos</td>
                </tr>
                <tr>
                  <th>Cidade</th>
                  <td><%= treinador.cidade %></td>
                </tr>
                <tr>
                  <th>Região</th>
                  <td><%= treinador.regiao %></td>
                </tr>
                <tr>
                  <th>Insígnias</th>
                  <td><%= treinador.insignias %>/8</td>
                </tr>
              </tbody>
            </table>

            <h6 class="mt-3">Pokémons cadastrados:</h6>
            <% if (treinador.pokemons && treinador.pokemons.length > 0) { %>
            <ul>
              <% treinador.pokemons.forEach(function(p) { %>
              <li><%= p.nome %></li>
              <% }) %>
            </ul>
            <% } else { %>
            <p>Nenhum Pokémon vinculado.</p>
            <% } %>

          </div>
        </div>
      </div>

    </div>
    <% } %>

  </div>

  <%- include('partials/footer') %>