<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

  <%- include('partials/navbar', { page: 'perfil' }) %>

  <div class="container mt-4">

    <h2 class="titulo-pagina">Perfil do Treinador</h2>

    <div class="row">
      <div class="col-md-4">
        <div class="card-perfil text-center">
          <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png" class="perfil-img" alt="Pikachu" />
          <h4 class="mt-2"><%= treinador.nome %></h4>
          <span class="badge bg-danger">Mestre Pokémon</span>
        </div>
      </div>

      <div class="col-md-8">
        <div class="card">
          <div class="card-body">
            <h5 class="card-title">Informações do Treinador</h5>
            <table class="table table-bordered">
              <tbody>
                <tr>
                  <th>Nome</th>
                  <td><%= treinador.nome %></td>
                </tr>
                <tr>
                  <th>Idade</th>
                  <td><%= treinador.idade %> anos</td>
                </tr>
                <tr>
                  <th>Cidade</th>
                  <td><%= treinador.cidade %></td>
                </tr>
                <tr>
                  <th>Região</th>
                  <td><%= treinador.regiao %></td>
                </tr>
                <tr>
                  <th>Insígnias</th>
                  <td><%= treinador.insignias %>/8</td>
                </tr>
                <tr>
                  <th>Pokémons Favoritos</th>
                  <td><%= treinador.pokemonsFavoritos.join(', ') %></td>
                </tr>
              </tbody>
            </table>

            <h6 class="mt-3">Conquistas:</h6>
            <ul>
              <% treinador.conquistas.forEach(function(c) { %>
                <li><%= c %></li>
              <% }) %>
            </ul>

            <p class="text-muted mt-2"><%= treinador.descricao %></p>
          </div>
        </div>
      </div>
    </div>

  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
