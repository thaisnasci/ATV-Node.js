<%- include('partials/header', { titulo: titulo }) %>
<%- include('partials/navbar', { page: 'pokedex' }) %>

<div class="container mt-4">

  <h2 class="titulo-pagina">Pokédex</h2>

  <table class="table table-striped table-bordered">
    <thead class="table-danger">
      <tr>
        <th>#</th>
        <th>Nome</th>
        <th>Tipo 1</th>
        <th>Tipo 2</th>
        <th>HP</th>
        <th>Ataque</th>
        <th>Defesa</th>
        <th>Velocidade</th>
        <th>Geração</th>
      </tr>
    </thead>

    <tbody>
      <% pokemons.forEach(p => { %>
        <tr>
          <td>#<%= String(p.id).padStart(3, '0') %></td>
          <td>
            <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/<%= p.id %>.png" class="pokemon-img">
            <%= p.nome %>
          </td>
          <td><%= p.tipo1 %></td>
          <td><%= p.tipo2 %></td>
          <td><%= p.hp %></td>
          <td><%= p.ataque %></td>
          <td><%= p.defesa %></td>
          <td><%= p.velocidade %></td>
          <td><%= p.geracao %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

</div>

<%- include('partials/footer') %>