<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

  <%- include('partials/navbar', { page: 'batalhas' }) %>

  <div class="container mt-4">

    <h2 class="titulo-pagina">Histórico de Batalhas</h2>
    <p>Confira as batalhas registradas entre os Pokémons.</p>

    <table class="table table-striped table-bordered">
      <thead class="table-danger">
        <tr>
          <th>#</th>
          <th>Pokémon 1</th>
          <th>VS</th>
          <th>Pokémon 2</th>
          <th>Vencedor</th>
          <th>Local</th>
          <th>Ano</th>
        </tr>
      </thead>
      <tbody>
        <% batalhas.forEach(function(b) { %>
          <tr>
            <td><%= b.id %></td>
            <td><%= b.pokemon1 %></td>
            <td class="text-center"><strong>VS</strong></td>
            <td><%= b.pokemon2 %></td>
            <td>
              <% if(b.vencedor === 'Empate') { %>
                <span>Empate</span>
              <% } else { %>
                <span><%= b.vencedor %></span>
              <% } %>
            </td>
            <td><%= b.local %></td>
            <td><%= b.ano %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
        <p class="text-muted">
          **Os dados foram simulados considerando as mecânicas de tipos e o universo Pokémon.
        </p>
 
  </div>

  <%- include('partials/footer') %>
  
</body>
</html>
