<%- include('partials/header', { titulo: titulo }) %>
<%- include('partials/navbar', { page: 'batalhas' }) %>

<div class="container mt-4">

  <h2 class="titulo-pagina">Histórico de Batalhas</h2>

  <table class="table table-striped table-bordered">
    <thead class="table-danger">
      <tr>
        <th>#</th>
        <th>Pokémon 1</th>
        <th>VS</th>
        <th>Pokémon 2</th>
        <th>Vencedor</th>
        <th>Local</th>
        <th>Ano</th>
      </tr>
    </thead>

    <tbody>
      <% batalhas.forEach(b => { %>
        <tr>
          <td><%= b.id %></td>
          <td><%= b.pokemon1 %></td>
          <td>VS</td>
          <td><%= b.pokemon2 %></td>
          <td><%= b.vencedor %></td>
          <td><%= b.local %></td>
          <td><%= b.ano %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

</div>

<%- include('partials/footer') %>