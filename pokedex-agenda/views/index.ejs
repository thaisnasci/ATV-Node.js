<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= titulo %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

  <%- include('partials/navbar', { page: 'home' }) %>

  <div class="container mt-4">

    <div class="text-center mb-4">
      <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png" class="home-img" alt="Pikachu" />
      <h1>Bem-vindo ao Site Pokémon!</h1>
      <p class="lead">Explore a Pokédex, veja o histórico de batalhas e gerencie seu perfil de treinador.</p>
    </div>

 <div class="row text-center mb-4">

  <div class="col-md-4 d-flex">
    <div class="card w-100 card-home">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Pokédex</h5>
        <p class="card-text">Veja todos os Pokémons cadastrados com seus atributos.</p>
        <a href="/pokedex" class="btn btn-danger mt-auto">Acessar Pokédex</a>
      </div>
    </div>
  </div>

  <div class="col-md-4 d-flex">
    <div class="card w-100 card-home">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Batalhas</h5>
        <p class="card-text">Confira o histórico de batalhas entre Pokémons.</p>
        <a href="/batalhas" class="btn btn-danger mt-auto">Ver Batalhas</a>
      </div>
    </div>
  </div>

  <div class="col-md-4 d-flex">
    <div class="card w-100 card-home">
      <div class="card-body d-flex flex-column">
        <h5 class="card-title">Treinador</h5>
        <p class="card-text">Veja as informações do treinador.</p>
        <a href="/perfil" class="btn btn-danger mt-auto">Ver Treinador</a>
      </div>
    </div>
  </div>

</div>

    

  </div>

  <%- include('partials/footer') %>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
