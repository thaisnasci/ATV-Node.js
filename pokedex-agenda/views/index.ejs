<%- include('partials/header', { titulo: titulo }) %>
<%- include('partials/navbar', { page: 'home' }) %>

<div class="container mt-4">

  <div class="text-center mb-4">
    <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/25.png" class="home-img" alt="Pikachu" />
    <h1>Bem-vindo ao Site Pokémon!</h1>
    <p class="lead">Explore a Pokédex, veja o histórico de batalhas e gerencie seu perfil de treinador.</p>
  </div>

  <div class="row text-center mb-4">

    <div class="col-md-4 d-flex">
      <div class="card w-100 card-home">
        <div class="card-body d-flex flex-column">
          <h5>Pokédex</h5>
          <p>Veja todos os Pokémons cadastrados.</p>
          <a href="/pokedex" class="btn btn-danger mt-auto">Acessar</a>
        </div>
      </div>
    </div>

    <div class="col-md-4 d-flex">
      <div class="card w-100 card-home">
        <div class="card-body d-flex flex-column">
          <h5>Batalhas</h5>
          <p>Confira batalhas entre Pokémons.</p>
          <a href="/batalhas" class="btn btn-danger mt-auto">Ver</a>
        </div>
      </div>
    </div>

    <div class="col-md-4 d-flex">
      <div class="card w-100 card-home">
        <div class="card-body d-flex flex-column">
          <h5>Treinador</h5>
          <p>Veja o perfil do treinador.</p>
          <a href="/treinador" class="btn btn-danger mt-auto">Ver</a>
        </div>
      </div>
    </div>

  </div>

</div>

<%- include('partials/footer') %>