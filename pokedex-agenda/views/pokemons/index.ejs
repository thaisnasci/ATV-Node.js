<%- include('../partials/header', { titulo: titulo }) %>
<%- include('../partials/navbar', { page: 'pokedex' }) %>

<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center titulo-pagina mb-3">
    <h2 class="mb-0">Pokédex</h2>
    <a href="/pokemons/novo" class="btn btn-danger">+ Novo Pokémon</a>
  </div>

  <table class="table table-striped table-bordered">
    <thead class="table-danger">
      <tr>
        <th>#</th>
        <th>Nome</th>
        <th>Tipo</th>
        <th>HP</th>
        <th>Ataque</th>
        <th>Defesa</th>
        <th>Velocidade</th>
        <th>Treinador</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% pokemons.forEach(p => { %>
        <tr>
          <td>#<%= String(p.numero).padStart(3, '0') %></td>
          <td>
            <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/<%= p.numero %>.png" style="width:40px">
            <%= p.nome %>
          </td>
          <td><%= p.tipo1 %><%= p.tipo2 !== '-' ? ' / ' + p.tipo2 : '' %></td>
          <td><%= p.hp %></td>
          <td><%= p.ataque %></td>
          <td><%= p.defesa %></td>
          <td><%= p.velocidade %></td>
          <td><%= p.treinador ? p.treinador.nome : '—' %></td>
          <td>
            <div class="d-flex gap-1">
              <a href="/pokemons/edit/<%= p.id %>" class="btn btn-sm btn-outline-secondary">✏️</a>
              <a href="/pokemons/delete/<%= p.id %>" class="btn btn-sm btn-outline-dark"
                 onclick="return confirm('Excluir este Pokémon?')">🗑️</a>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
